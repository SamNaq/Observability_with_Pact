{
  "name": "demo-observability",
  "version": "1.0.0",
  "description": "Demo application with Pact contract testing and observability",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start:provider": "node dist/provider/server.js",
    "start:consumer": "node dist/consumer/server.js",
    "dev:provider": "ts-node-dev --respawn --transpile-only provider/server.ts",
    "dev:consumer": "ts-node-dev --respawn --transpile-only consumer/server.ts",
    "test:consumer": "jest --config jest.consumer.config.js --coverage && node scripts/report-coverage.js consumer",
    "test:provider": "jest --config jest.provider.config.js --coverage && node scripts/report-coverage.js provider",
    "test:integration": "jest --config jest.integration.config.js --coverage && node scripts/report-coverage.js integration",
    "test:provider:fail": "DEMO_FAIL_PROVIDER=true jest --config jest.provider.config.js --coverage && node scripts/report-coverage.js provider",
    "test": "npm run test:consumer && npm run test:provider && npm run test:integration",
    "pact:publish": "node scripts/publish-pacts.js",
    "metrics:push": "node scripts/start-metrics-pusher.js",
    "grafana:setup": "node scripts/setup-grafana-cloud.js"
  },
  "keywords": [
    "pact",
    "contract-testing",
    "observability",
    "grafana",
    "prometheus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/exporter-prometheus": "^0.208.0",
    "@pact-foundation/pact": "^13.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "prom-client": "^15.0.0",
    "prometheus-remote-write": "^0.5.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "yaml": "^2.8.1"
  }
}
